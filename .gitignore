# Keep only release source and documentation in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MACOS.md
!/CHANGELOG-macOS.md
!/docs/
!/desktop/
!/native-swift/
/desktop/*
!/desktop/EmbeddedWebSync.js
/native-swift/*
!/native-swift/Sources/
!/native-swift/Tests/
!/native-swift/Package.swift
!/native-swift/VERSION
!/native-swift/Build-App.sh
!/native-swift/Prepare-Runtime.sh
!/native-swift/Prepare-Runtime.command
!/native-swift/Prepare-Git.sh
!/native-swift/Fetch-Dependencies.py
!/native-swift/OfflineDependencies.json
!/native-swift/Smoke-Check.sh
!/native-swift/Check-Window.swift
!/native-swift/dependencies/
/native-swift/dependencies/*
!/native-swift/dependencies/payload/
/native-swift/dependencies/payload/*
!/native-swift/dependencies/payload/bot/

# Never publish local credentials, runtime state or build output.
**/node_modules/
**/dist/
**/.build/
**/.swiftpm/
**/.tmp/
**/coverage/
**/logs/
**/run/
**/.env
**/.env.*
!**/.env.example
**/settings.json*
**/*.log
**/*.sqlite*
**/*.db
**/*.db-*
**/.DS_Store
**/*.dmg
**/*.app/
**/*.tgz
**/*.pem
**/*.key
**/e2e/output/
# Public, committed localhost-only TLS fixture used by the proxy tests.
!/native-swift/dependencies/payload/bot/e2e/forward-proxy-test-only.key
